---
import "@fontsource-variable/geist";
import "../styles/global.css";
import { assetPath, profile } from "../data/profile";

const faviconUrl = assetPath(import.meta.env.BASE_URL, "favicon.svg");
const title = `Page not found — ${profile.name}`;
const heading = "This page does not exist.";
const summary =
  "The link may be outdated or mistyped. The full profile, experience and CV are on the home page.";
const spanishSummary =
  "La página que buscas no existe. Consulta el perfil completo en español.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171918" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={summary} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell" id="top">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>
          em<span>.</span>
        </a>
      </header>
      <main id="main" class="not-found">
        <section class="hero" aria-labelledby="not-found-title">
          <p class="eyebrow">Error 404</p>
          <h1 id="not-found-title">{heading}</h1>
          <p class="hero-summary">{summary}</p>
          <p class="hero-summary" lang="es">{spanishSummary}</p>
          <div class="hero-actions">
            <a class="button" href="/">
              Back to home <span aria-hidden="true">←</span>
            </a>
            <a class="text-link" href="/es/" hreflang="es" lang="es">
              Ir a la versión en español <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
