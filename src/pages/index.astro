---
import "../styles/global.css";
import { profile, experience, toolkit, assetPath } from "../data/profile";
const cvUrl = assetPath(import.meta.env.BASE_URL, profile.cvFilename);
const faviconUrl = assetPath(import.meta.env.BASE_URL, "favicon.svg");
const description =
  "Eric Marès — Software Engineer in Córdoba, Spain. Full-stack development and applied AI with TypeScript, React, Next.js, and Node.js. Experience at The Knot Worldwide, ALTEN, and Wheel Hub.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171918" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${profile.name} — Software Engineer`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{profile.name} — Software Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="shell">
      <header class="site-header">
        <a
          class="wordmark"
          href="#"
          aria-label={`${profile.name}, back to top`}
        >
          em<span>.</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
          <a
            class="nav-cv"
            href={cvUrl}
            download
            aria-label="Download CV (PDF)"
          >
            CV <span aria-hidden="true">↓</span>
          </a>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <p class="eyebrow">{profile.location}</p>
          <h1 id="hero-title">
            {profile.name}
          </h1>
          <p class="hero-role">{profile.role}</p>
          <p class="hero-summary">
            I develop web applications and AI-powered features with TypeScript,
            React, Next.js, and Node.js. Currently at The Knot Worldwide,
            building frontend and backend features for The Bump.
          </p>
          <div class="hero-actions">
            <a class="button" href={cvUrl} download>
              Download CV <span aria-hidden="true">↓</span>
              <span class="sr-only"> (PDF)</span>
            </a>
            <a class="text-link" href={`mailto:${profile.email}`}>
              Contact me <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
        <section
          id="experience"
          class="section"
          aria-labelledby="experience-title"
        >
          <h2 id="experience-title">Experience</h2>
          <div class="timeline">
            {experience.map((job) => (
              <article class="job">
                <div class="job-date">
                  <p>
                    <time datetime={job.start}>
                      {job.period.split(" — ")[0]}
                    </time>{" "}
                    —{" "}
                    {job.end ? (
                      <time datetime={job.end}>
                        {job.period.split(" — ")[1]}
                      </time>
                    ) : (
                      "Present"
                    )}
                  </p>
                  <span>Fully remote</span>
                </div>
                <div class="job-body">
                  <h3>{job.company}</h3>
                  <p class="job-role">{job.role}</p>
                  <p class="job-description">{job.description}</p>
                  <ul class="accomplishments">
                    {job.accomplishments.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>
        <div class="background-grid">
          <section id="skills" class="section" aria-labelledby="skills-title">
            <h2 id="skills-title">Skills</h2>
            <dl class="toolkit">
              {toolkit.map((group) => (
                <div>
                  <dt>{group.name}</dt>
                  <dd>{group.items}</dd>
                </div>
              ))}
            </dl>
          </section>
          <section
            id="education"
            class="section"
            aria-labelledby="education-title"
          >
            <h2 id="education-title">Education</h2>
            <div class="education">
              <h3>Multiplatform Application Development</h3>
              <p>
                Escola Pia Mataró <span>2015 — 2017</span>
              </p>
              <p class="additional-learning">
                Additional learning: React Native — The Practical Guide
              </p>
            </div>
            <div class="languages">
              <h3>Languages</h3>
              <p>
                Catalan & Spanish <span>Native</span>
              </p>
              <p>
                English <span>Professional working proficiency</span>
              </p>
            </div>
          </section>
        </div>
        <section
          id="contact"
          class="section contact"
          aria-labelledby="contact-title"
        >
          <h2 id="contact-title">Contact</h2>
          <div class="contact-links">
            <a class="email" href={`mailto:${profile.email}`}>
              {profile.email}
            </a>
            <div class="social-links">
              <a href={profile.linkedin}>
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
              <a href={profile.github}>
                GitHub <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </section>
      </main>
      <footer>
        <span>
          © {new Date().getFullYear()} {profile.name}
        </span>
        <a href="#">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </footer>
    </div>
  </body>
</html>
