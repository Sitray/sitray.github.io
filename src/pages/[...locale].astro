---
import type { GetStaticPaths } from "astro";
import "@fontsource-variable/geist";
import "../styles/global.css";
import { assetPath, experience, profile, toolkit } from "../data/profile";
import {
  formatMonth,
  locales,
  siteContent,
  type Locale,
} from "../data/site-content";

export const getStaticPaths = (() => [
  { params: { locale: undefined }, props: { locale: "en" as const } },
  { params: { locale: "es" }, props: { locale: "es" as const } },
]) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const content = siteContent[locale];
const cvUrl = assetPath(import.meta.env.BASE_URL, profile.cvFilename);
const faviconUrl = assetPath(import.meta.env.BASE_URL, "favicon.svg");
const localePath = locale === "en" ? "/" : "/es/";
const absoluteUrl = (path: string) => new URL(path, Astro.site).href;
const canonicalUrl = absoluteUrl(localePath);
const ogLocales = { en: "en_US", es: "es_ES" } as const;
const ogLocale = ogLocales[locale];
const ogLocaleAlternate = ogLocales[locale === "en" ? "es" : "en"];
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171918" />
    <meta name="description" content={content.description} />
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" hreflang="en" href={absoluteUrl("/")} />
    <link rel="alternate" hreflang="es" href={absoluteUrl("/es/")} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl("/")} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{content.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{content.skipLink}</a>
    <div class="shell" id="top">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label={content.wordmarkLabel}>
          em<span>.</span>
        </a>
        <div class="header-navigation">
          <nav aria-label={content.navigationLabel}>
            <a href="#experience">{content.nav.experience}</a>
            <a href="#contact">{content.nav.contact}</a>
            <a
              class="nav-cv"
              href={cvUrl}
              download
              aria-label={content.cv.downloadLabel}
            >
              {content.nav.cv} <span aria-hidden="true">↓</span>
            </a>
          </nav>
          <nav class="language-nav" aria-label={content.languageNavigationLabel}>
            {locales.map((language) => (
              <a
                href={language === "en" ? "/" : "/es/"}
                hreflang={language}
                aria-current={language === locale ? "page" : undefined}
              >
                {language.toUpperCase()}
                <span class="sr-only">
                  {language === locale ? ` (${content.localeName})` : ""}
                </span>
              </a>
            ))}
          </nav>
        </div>
      </header>
      <main id="main" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <p class="eyebrow">{content.location}</p>
          <h1 id="hero-title">{profile.name}</h1>
          <p class="hero-role">{content.role}</p>
          <p class="hero-summary">{content.heroSummary}</p>
          <div class="hero-actions">
            <a class="button" href={cvUrl} download>
              {content.cv.download} <span aria-hidden="true">↓</span>
              <span class="sr-only"> ({content.cv.documentLanguage})</span>
            </a>
            <a class="text-link" href={`mailto:${profile.email}`}>
              {content.contactCta} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
        <section
          id="experience"
          class="section"
          aria-labelledby="experience-title"
        >
          <h2 id="experience-title">{content.sections.experience}</h2>
          <div class="timeline">
            {experience.map((job, index) => {
              const localizedJob = content.jobs[index];
              return (
                <article class="job">
                  <div class="job-date">
                    <p>
                      <time datetime={job.start}>
                        {formatMonth(job.start, locale)}
                      </time>{" "}
                      —{" "}
                      {job.end ? (
                        <time datetime={job.end}>
                          {formatMonth(job.end, locale)}
                        </time>
                      ) : (
                        content.present
                      )}
                    </p>
                    <span>{content.remote}</span>
                  </div>
                  <div class="job-body">
                    <h3>{job.company}</h3>
                    <p class="job-role">{localizedJob.role}</p>
                    <p class="job-description">{localizedJob.description}</p>
                    <ul class="accomplishments">
                      {localizedJob.accomplishments.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
        <div class="background-grid">
          <section id="skills" class="section" aria-labelledby="skills-title">
            <h2 id="skills-title">{content.sections.skills}</h2>
            <dl class="toolkit">
              {toolkit.map((group, index) => (
                <div>
                  <dt>{content.toolkitLabels[index]}</dt>
                  <dd>{group.items}</dd>
                </div>
              ))}
            </dl>
          </section>
          <section
            id="education"
            class="section"
            aria-labelledby="education-title"
          >
            <h2 id="education-title">{content.sections.education}</h2>
            <div class="education">
              <h3>{content.education.qualification}</h3>
              <p>
                Escola Pia Mataró <span>2015 — 2017</span>
              </p>
              <p class="additional-learning">
                {content.education.additionalLearning}
              </p>
            </div>
            <div class="languages">
              <h3>{content.sections.languages}</h3>
              {content.languages.map((language) => (
                <p>
                  {language.name} <span>{language.proficiency}</span>
                </p>
              ))}
            </div>
          </section>
        </div>
        <section
          id="contact"
          class="section contact"
          aria-labelledby="contact-title"
        >
          <h2 id="contact-title">{content.sections.contact}</h2>
          <div class="contact-links">
            <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
            <div class="social-links">
              <a href={profile.linkedin}>
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
              <a href={profile.github}>
                GitHub <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </section>
      </main>
      <footer>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <a href="#top">
          {content.footerBackToTop} <span aria-hidden="true">↑</span>
        </a>
      </footer>
    </div>
  </body>
</html>
